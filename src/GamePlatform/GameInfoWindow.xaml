<Window x:Class="GamePlatform.GameInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamePlatform"
        mc:Ignorable="d"
        Title="게임 정보" Height="700" Width="560"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        DragOver="ScreenshotArea_DragOver"
        Drop="ScreenshotArea_Drop"
        Closed="GameInfoWindow_Closed">
    <Window.Resources>
        <local:ThumbnailPathConverter x:Key="ThumbnailPathConverter"/>
        <local:EmptyPathToVisibleConverter x:Key="EmptyPathToVisibleConverter"/>
        <local:ProgressColorConverter x:Key="ProgressColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibleConverter"/>

        <!-- 평점/신사 등급 슬라이더의 "채워진 부분"(진행 정도에 따라 색이 바뀜)과 "안 채워진 부분"(연한 회색
             배경) — 기본 RepeatButton 크롬을 걷어내고 단색 Border만 남긴다. 공유 스타일이라 TemplatedParent가
             아니라 AncestorType=Slider로 값을 찾는다. -->
        <Style x:Key="RatingFillRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border CornerRadius="13"
                                Background="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, Converter={StaticResource ProgressColorConverter}}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RatingEmptyRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- sample.png 참고 — 진행률(0~100) 구간마다 채워진 막대 색이 바뀌는 알약 모양 슬라이더(배경은
             연한 회색 고정, 2026-09-06 수정 — 막대/배경 색을 서로 바꿔달라는 사용자 요청). 보통
             ProgressBar가 아니라 Slider를 쓰는 이유는 막대를 직접 클릭/드래그해서 값을 바로 지정해야
             하기 때문이다(IsMoveToPointEnabled). Thumb은 크기 0으로 감춰서, 눈에는 색 채움 막대가
             늘었다 줄었다 하는 것처럼만 보인다. -->
        <Style x:Key="RatingSliderStyle" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border CornerRadius="13" Background="#E3E3E3"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource RatingFillRepeatButtonStyle}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="0" Height="0" Opacity="0"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource RatingEmptyRepeatButtonStyle}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="게임 이름"/>
            <TextBox x:Name="NameTextBox" TextChanged="NameTextBox_TextChanged" Margin="0,2,0,10"/>

            <TextBlock Text="게임 버전"/>
            <TextBox x:Name="VersionTextBox" TextChanged="VersionTextBox_TextChanged" Margin="0,2,0,10"/>

            <TextBlock Text="실행 파일 경로"/>
            <DockPanel Margin="0,2,0,10">
                <Button Content="찾아보기" DockPanel.Dock="Right" Margin="4,0,0,0" Click="BrowseExecutable_Click"/>
                <TextBox x:Name="ExecutablePathTextBox" IsReadOnly="True"/>
            </DockPanel>
            <Button Content="게임 폴더 이름 변경..." HorizontalAlignment="Left" Margin="0,0,0,10" Click="RenameGameFolder_Click"/>

            <StackPanel x:Name="ArchiveInfoPanel" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock Text="압축 정보"/>
                <TextBlock x:Name="ArchiveInfoTextBlock" TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,0"/>
            </StackPanel>

            <Button Content="이름이 같은 모든 버전에 게임 내용/게임 요약 통합" HorizontalAlignment="Left"
                    Margin="0,0,0,10" Click="MergeVersions_Click"/>

            <TextBlock Text="게임 내용"/>
            <TextBox x:Name="DescriptionTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="140" VerticalScrollBarVisibility="Auto"
                     TextChanged="DescriptionTextBox_TextChanged" Margin="0,2,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="평점"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="RatingSlider" Grid.Column="0" Style="{StaticResource RatingSliderStyle}"
                                Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="RatingSlider_ValueChanged"/>
                        <Button Grid.Column="1" Content="&lt;" Width="22" Margin="4,0,0,0" Click="RatingDecrease_Click"/>
                        <TextBox x:Name="RatingTextBox" Grid.Column="2" Width="40" Margin="4,0,0,0"
                                 TextAlignment="Center" VerticalContentAlignment="Center"
                                 TextChanged="RatingTextBox_TextChanged"/>
                        <Button Grid.Column="3" Content="&gt;" Width="22" Margin="4,0,0,0" Click="RatingIncrease_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="신사 등급"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="GentlemanGradeSlider" Grid.Column="0" Style="{StaticResource RatingSliderStyle}"
                                Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="GentlemanGradeSlider_ValueChanged"/>
                        <Button Grid.Column="1" Content="&lt;" Width="22" Margin="4,0,0,0" Click="GentlemanGradeDecrease_Click"/>
                        <TextBox x:Name="GentlemanGradeTextBox" Grid.Column="2" Width="40" Margin="4,0,0,0"
                                 TextAlignment="Center" VerticalContentAlignment="Center"
                                 TextChanged="GentlemanGradeTextBox_TextChanged"/>
                        <Button Grid.Column="3" Content="&gt;" Width="22" Margin="4,0,0,0" Click="GentlemanGradeIncrease_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <TextBlock Text="게임 요약 (첫 번째는 메인 화면 대표 썸네일입니다. 이 창에 이미지를 끌어다 놓으면 추가됩니다. 클릭하면 원본 크기로 봅니다. 우클릭으로 삭제)"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                <TextBlock Text="이미지 크기:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <RadioButton x:Name="ScreenshotLargeRadio" GroupName="ScreenshotSize" Content="320x240"
                             Checked="ScreenshotLargeRadio_Checked" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="ScreenshotMediumRadio" GroupName="ScreenshotSize" Content="160x120"
                             Checked="ScreenshotMediumRadio_Checked" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="ScreenshotSmallRadio" GroupName="ScreenshotSize" Content="80x60"
                             Checked="ScreenshotSmallRadio_Checked" VerticalAlignment="Center"/>
            </StackPanel>
            <ItemsControl x:Name="ScreenshotsItemsControl" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4" BorderBrush="Gray" BorderThickness="1" Background="Transparent"
                                MouseLeftButtonUp="Screenshot_Click">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="삭제" Click="DeleteScreenshot_Click"
                                              Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVisibleConverter}}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid Width="{Binding Source={x:Static local:GameScreenshotSizeSettings.Current}, Path=Width}"
                                  Height="{Binding Source={x:Static local:GameScreenshotSizeSettings.Current}, Path=Height}">
                                <Border Background="#22000000"
                                        Visibility="{Binding Path, Converter={StaticResource EmptyPathToVisibleConverter}}">
                                    <TextBlock Text="썸네일 없음" Foreground="Gray"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding Path, Converter={StaticResource ThumbnailPathConverter}}" Stretch="Uniform"/>
                                <Border Background="#AA000000" VerticalAlignment="Bottom"
                                        Visibility="{Binding IsCover, Converter={StaticResource BoolToVisibleConverter}}">
                                    <TextBlock Text="대표 이미지" Foreground="White" Margin="2" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>
