<Window x:Class="GamePlatform.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamePlatform"
        mc:Ignorable="d"
        Title="Game Platform" Height="720" Width="1100"
        Icon="Assets/AppIcon.ico"
        AllowDrop="True"
        DragOver="MainWindow_DragOver"
        Drop="MainWindow_Drop"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <local:ThumbnailPathConverter x:Key="ThumbnailPathConverter"/>
    </Window.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <TextBlock Text="카드 크기:" VerticalAlignment="Center" Margin="6,0"/>
                <RadioButton x:Name="LargeSizeRadio" GroupName="CardSize" Content="320x240"
                             Checked="LargeSizeRadio_Checked" Margin="4,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="SmallSizeRadio" GroupName="CardSize" Content="160x120"
                             Checked="SmallSizeRadio_Checked" Margin="8,0" VerticalAlignment="Center"/>
            </ToolBar>
        </ToolBarTray>
        <TextBlock DockPanel.Dock="Bottom" Margin="8" Foreground="Gray"
                   Text="실행 파일(exe)을 이 창에 끌어다 놓으면 새 게임이 추가됩니다. 카드에 이미지를 끌어다 놓으면 대표 썸네일이 지정됩니다. 카드 우클릭으로 삭제할 수 있습니다."/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GamesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8" Padding="6" BorderBrush="Gray" BorderThickness="1"
                                Width="{Binding Source={x:Static local:GameCardSizeSettings.Current}, Path=CardWidth}"
                                AllowDrop="True"
                                DragOver="Card_DragOver"
                                Drop="Card_Drop">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="삭제" Click="DeleteGame_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailPathConverter}}"
                                       Width="{Binding Source={x:Static local:GameCardSizeSettings.Current}, Path=ThumbnailWidth}"
                                       Height="{Binding Source={x:Static local:GameCardSizeSettings.Current}, Path=ThumbnailHeight}"
                                       Stretch="Uniform"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,4"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="정보" Width="60" Margin="4" Click="InfoButton_Click"/>
                                    <Button Content="실행" Width="60" Margin="4" Click="RunButton_Click"
                                            IsEnabled="{Binding IsExecutableValid}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
