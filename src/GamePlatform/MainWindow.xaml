<Window x:Class="GamePlatform.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamePlatform"
        mc:Ignorable="d"
        Title="Game Platform" Height="720" Width="1100"
        Icon="Assets/AppIcon.ico"
        AllowDrop="True"
        DragOver="MainWindow_DragOver"
        Drop="MainWindow_Drop"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <local:ThumbnailPathConverter x:Key="ThumbnailPathConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibleConverter"/>
        <!-- 아이콘/리스트 보기 양쪽에서 공유하는 카드 우클릭 메뉴(doc/game-management.md "메인 화면" 참고) —
             ContextMenu는 일반 시각 트리 요소가 아니라(별도의 팝업 루트) 여러 컨트롤의 ContextMenu 속성에서
             같은 리소스 인스턴스를 그대로 참조해도 되고, 열릴 때 PlacementTarget(카드/행)의 DataContext를
             그대로 물려받는다. -->
        <ContextMenu x:Key="GameCardContextMenu">
            <MenuItem Header="썸네일 삭제" Click="DeleteThumbnail_Click"
                      Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibleConverter}}"/>
            <MenuItem Header="압축" Click="CompressGame_Click"
                      Visibility="{Binding CanCompress, Converter={StaticResource BoolToVisibleConverter}}"/>
            <MenuItem Header="압축 풀기" Click="ExtractGame_Click"
                      Visibility="{Binding CanExtract, Converter={StaticResource BoolToVisibleConverter}}"/>
            <MenuItem Header="삭제" Click="DeleteGame_Click"/>
        </ContextMenu>
        <!-- 리스트 보기(테이블) 헤더 우클릭 메뉴 — 선택적 칼럼(버전/평점/신사 등급/폴더)을 켜고 끈다.
             "게임 이름"/"정보"/"실행"은 항상 보이므로 여기 없다(doc/game-management.md "메인 화면" 참고). -->
        <ContextMenu x:Key="ListColumnVisibilityMenu">
            <MenuItem Header="버전" IsCheckable="True" Click="ToggleVersionColumn_Click"/>
            <MenuItem Header="평점" IsCheckable="True" Click="ToggleRatingColumn_Click"/>
            <MenuItem Header="신사 등급" IsCheckable="True" Click="ToggleGentlemanGradeColumn_Click"/>
            <MenuItem Header="폴더" IsCheckable="True" Click="ToggleFolderColumn_Click"/>
        </ContextMenu>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="열기(_O)..." Click="OpenGameDb_Click"/>
                <MenuItem Header="저장(_S)" Click="SaveGameDb_Click"/>
                <MenuItem Header="다른 이름으로 저장(_A)..." Click="SaveGameDbAs_Click"/>
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="정렬">
                    <MenuItem x:Name="AscendingSortMenuItem" Header="오름차순" IsCheckable="True" Click="AscendingSortMenuItem_Click"/>
                    <MenuItem x:Name="DescendingSortMenuItem" Header="내림차순" IsCheckable="True" Click="DescendingSortMenuItem_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="ListViewMenuItem" Header="리스트 보기" IsCheckable="True" Click="ListViewMenuItem_Click"/>
                <MenuItem x:Name="IconViewMenuItem" Header="아이콘 보기" IsCheckable="True" Click="IconViewMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="카드 크기">
                    <MenuItem x:Name="LargeSizeMenuItem" Header="320x240" IsCheckable="True" Click="LargeSizeMenuItem_Click"/>
                    <MenuItem x:Name="SmallSizeMenuItem" Header="160x120" IsCheckable="True" Click="SmallSizeMenuItem_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="설정(_S)">
                <MenuItem Header="환경설정..." Click="OpenPreferences_Click"/>
                <Separator/>
                <MenuItem Header="분류 폴더 안의 게임 정리..." Click="CleanUpCategoryFolderGames_Click"/>
            </MenuItem>
        </Menu>
        <!-- 상태바(video-vault의 SeriesManagerWindow 패턴) — 게임 추가/삭제/썸네일 지정/압축 등 각종 이벤트를
             대화상자 대신 여기 표시한다. 종류(성공/경고/정보/오류)에 따라 아이콘과 글자색이 SetStatus에서 정해진다. -->
        <Border DockPanel.Dock="Bottom" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1"
                Background="#FAFAFA" Padding="10,6" Margin="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="StatusIcon" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel x:Name="CompressProgressPanel" Grid.Column="1" Orientation="Horizontal"
                            Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="CompressProgressLabel" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="CompressProgressBar" Width="140" Height="14" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid>
            <!-- 아이콘 보기(기존 썸네일 카드 그리드) — 보기 > 아이콘 보기(기본값)일 때만 보인다. `ItemsControl`은
                 자체 스크롤 기능이 없으므로 전용 ScrollViewer로 감싼다. 리스트 보기(아래 ListView)는 자체
                 스크롤을 내장하고 있어 같은 ScrollViewer로 같이 감싸면 안 된다 — 감싸면 마우스 휠 이벤트를
                 안쪽 ScrollViewer가 항상 먼저 소비해버려서(실제로 스크롤할 내용이 없어도) 바깥쪽으로 넘어가지
                 않아 리스트 보기에서 스크롤이 안 되는 문제가 있었다(2026-09-06 수정, 사용자 요청). -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GamesItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8" Padding="6" BorderBrush="Gray" BorderThickness="1" Background="Transparent"
                                    Width="{Binding Source={x:Static local:GameCardSizeSettings.Current}, Path=CardWidth}"
                                    AllowDrop="True"
                                    DragOver="Card_DragOver"
                                    Drop="Card_Drop"
                                    ContextMenu="{StaticResource GameCardContextMenu}">
                                <StackPanel>
                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailPathConverter}}"
                                           Width="{Binding Source={x:Static local:GameCardSizeSettings.Current}, Path=ThumbnailWidth}"
                                           Height="{Binding Source={x:Static local:GameCardSizeSettings.Current}, Path=ThumbnailHeight}"
                                           Stretch="Uniform"/>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Margin="0,4"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="정보" Width="60" Margin="4" Click="InfoButton_Click"/>
                                        <Button Content="실행" Width="70" Margin="4" Click="RunButton_Click"
                                                IsEnabled="{Binding IsRunButtonEnabled}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- 리스트 보기(테이블) — 썸네일 없이 칼럼으로 정보를 보여준다. 보기 > 리스트 보기를 고르면
                 보인다(doc/game-management.md "메인 화면" 참고). "게임 이름"/"정보"/"실행" 칼럼은 항상
                 보이고, 나머지(버전/평점/신사 등급/폴더)는 헤더 우클릭 메뉴로 켜고 끌 수 있다 —
                 MainWindow.xaml.cs의 RebuildListColumns가 켜진 칼럼만 골라 Columns에 순서대로 채운다.
                 `ListView`는 스크롤을 자체 내장하므로 위 아이콘 보기처럼 별도 ScrollViewer로 감싸지 않는다.
                 `TextSearch.TextPath="Name"`은 WPF `ListBox`/`ListView`에 내장된 기능을 그대로 쓰는 것 —
                 포커스가 있을 때 키보드로 글자를 치면 탐색기처럼 그 글자로 시작하는 `Name`을 가진 행으로
                 바로 찾아간다(같은 글자를 계속 치면 다음 일치 항목으로 순환, 2026-09-06 추가, 사용자 요청).
                 커스텀 `GridView` 셀 템플릿을 쓰면 항목의 기본 텍스트(ToString)를 알 수 없어 이 속성 없이는
                 동작하지 않는다. -->
            <ListView x:Name="GamesListView" Visibility="Collapsed"
                      TextSearch.TextPath="Name"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="ContextMenu" Value="{StaticResource GameCardContextMenu}"/>
                        <Setter Property="AllowDrop" Value="True"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <EventSetter Event="DragOver" Handler="Card_DragOver"/>
                        <EventSetter Event="Drop" Handler="Card_Drop"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView x:Name="GamesGridView">
                        <GridView.ColumnHeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="ContextMenu" Value="{StaticResource ListColumnVisibilityMenu}"/>
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn x:Name="NameColumn" Header="게임 이름" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="VersionColumn" Header="버전" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Version}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="RatingColumn" Header="평점" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Rating, StringFormat={}{0:0}%}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="GentlemanGradeColumn" Header="신사 등급" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GentlemanGrade, StringFormat={}{0:0}%}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="FolderColumn" Header="폴더" Width="240">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FolderPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="InfoColumn" Header="정보" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="정보" Width="50" Click="InfoButton_Click"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="RunColumn" Header="실행" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="실행" Width="60" Click="RunButton_Click"
                                            IsEnabled="{Binding IsRunButtonEnabled}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
